{
  "outputDirectory": "Front_end",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https:;"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/google52e2fe7176c0247e.html", "destination": "/google52e2fe7176c0247e.html" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/jobs", "destination": "/explore-jobs.html" },
    { "source": "/freelancers", "destination": "/explore-freelancers.html" },
    { "source": "/how-it-works", "destination": "/how-it-works.html" },
    { "source": "/login", "destination": "/sharedFolder/login.html" },
    { "source": "/login.html", "destination": "/sharedFolder/login.html" },
    { "source": "/register", "destination": "/sharedFolder/register.html" },
    { "source": "/register.html", "destination": "/sharedFolder/register.html" },
    { "source": "/forgot-password", "destination": "/sharedFolder/forgot-password.html" },
    { "source": "/forgot-password.html", "destination": "/sharedFolder/forgot-password.html" }
  ]
}
